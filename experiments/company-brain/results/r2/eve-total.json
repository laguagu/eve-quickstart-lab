  {
   "data": {
    "callId": "toolu_0122dTx3p5Hfj5rZXLby69kn",
    "outcome": "completed",
    "output": {
     "builtAt": "2026-10-14T15:34:05.056138Z",
     "name": "orders",
     "relation": "main.orders",
     "description": "This table has basic information about orders, as well as some derived facts based on payments",
     "sql": "with order_payments as (\n    select\n        order_id,\n        sum(case when payment_method = 'credit_card' then amount else 0 end) as credit_card_amount,\n        sum(case when payment_method = 'coupon' then amount else 0 end) as coupon_amount,\n        sum(case when payment_method = 'bank_transfer' then amount else 0 end) as bank_transfer_amount,\n        sum(case when payment_method = 'gift_card' then amount else 0 end) as gift_card_amount,\n        sum(amount) as amount\n    from \"jaffle_shop\".\"main\".\"stg_payments\"\n    group by order_id\n)\n\nselect\n    orders.order_id,\n    orders.customer_id,\n    orders.order_date,\n    orders.status,\n    order_payments.credit_card_amount,\n    order_payments.coupon_amount,\n    order_payments.bank_transfer_amount,\n    order_payments.gift_card_amount,\n    order_payments.amount\nfrom \"jaffle_shop\".\"main\".\"stg_orders\" as orders\nleft join order_payments\n    on orders.order_id = order_payments.order_id",
     "meta": {
      "grain": "One row per order.",
      "joins": [
       "orders.customer_id = customers.customer_id (many orders to one customer)."
      ],
      "metrics": {
       "amount": "Sum of all recorded payments for this order in AUD, including coupons and gift cards, regardless of order status. Not net revenue or profit.",
       "order_count": "COUNT(*) on orders. For completed orders filter status = 'completed'.",
       "average_order_amount": "AVG(amount) on orders; excludes NULL amounts."
      },
      "caveats": [
       "No refund ledger, tax breakdown, costs, or payment timestamps are available.",
       "order_date is the order placement date, not the payment date.",
       "The bundled seeds are historical synthetic data. Inspect MIN/MAX(order_date) before choosing dates."
      ]
     },
     "dependsOn": [
      "stg_payments",
      "stg_orders"
     ],
     "columns": [
      {
       "name": "order_id",
       "type": "INTEGER",
       "description": "This is a unique identifier for an order"
      },
      {
       "name": "customer_id",
       "type": "INTEGER",
       "description": "Foreign key to the customers table"
      },
      {
       "name": "order_date",
       "type": "DATE",
       "description": "Date (UTC) that the order was placed"
      },
      {
       "name": "status",
       "type": "VARCHAR",
       "description": "Orders can be one of the following statuses:\n\n| status         | description                                                                                                            |\n| -------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| placed         | The order has been placed but has not yet left the warehouse                                                           |\n| shipped        | The order has ben shipped to the customer and is currently in transit                                                  |\n| completed      | The order has been received by the customer                                                                            |\n| return_pending | The customer has indicated that they would like to return the order, but it has not yet been received at the warehouse |\n| returned       | The order has been returned by the customer and received at the warehouse                                              |"
      },
      {
       "name": "credit_card_amount",
       "type": "DOUBLE",
       "description": "Amount of the order (AUD) paid for by credit card"
