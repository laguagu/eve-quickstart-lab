     "builtAt": "2026-10-14T15:34:05.056138Z",
     "name": "customers",
     "relation": "main.customers",
     "description": "This table has basic information about a customer, as well as some derived facts based on a customer's orders",
     "sql": "with customer_orders as (\n    select\n        customer_id,\n        min(order_date) as first_order,\n        max(order_date) as most_recent_order,\n        count(*) as number_of_orders,\n        sum(amount) as customer_lifetime_value\n    from \"jaffle_shop\".\"main\".\"orders\"\n    group by customer_id\n)\n\nselect\n    customers.customer_id,\n    customers.first_name,\n    customers.last_name,\n    customer_orders.first_order,\n    customer_orders.most_recent_order,\n    customer_orders.number_of_orders,\n    customer_orders.customer_lifetime_value\nfrom \"jaffle_shop\".\"main\".\"stg_customers\" as customers\nleft join customer_orders\n    on customers.customer_id = customer_orders.customer_id",
     "meta": {
      "grain": "One row per customer, including customers with no orders.",
      "joins": [
       "customers.customer_id = orders.customer_id (one customer to many orders); aggregate order values before joining customer totals."
      ],
      "metrics": {
       "customer_lifetime_value": "Lifetime payment amount in AUD across all orders, including returned orders; not net revenue. Use orders.amount for date-filtered totals.",
       "number_of_orders": "All orders placed by the customer, regardless of status."
      }
     },
     "dependsOn": [
      "orders",
      "stg_customers"
     ],
     "columns": [
      {
       "name": "customer_id",
       "type": "INTEGER",
       "description": "This is a unique identifier for a customer"
      },
      {
       "name": "first_name",
       "type": "VARCHAR",
       "description": "Customer's first name. PII."
      },
      {
       "name": "last_name",
       "type": "VARCHAR",
       "description": "Customer's last name. PII."
      },
      {
       "name": "first_order",
       "type": "DATE",
       "description": "Date (UTC) of a customer's first order"
      },
      {
       "name": "most_recent_order",
       "type": "DATE",
       "description": "Date (UTC) of a customer's most recent order"
      },
      {
       "name": "number_of_orders",
       "type": "BIGINT",
       "description": "Count of the number of orders a customer has placed"
      },
      {
       "name": "customer_lifetime_value",
       "type": "DOUBLE",
       "description": "Lifetime recorded payments in AUD across all of the customer's orders, including returned orders. Not net revenue."
      }
     ]
